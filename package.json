{
  "name": "dsh-minimal-ptc",
  "version": "0.6.15",
  "description": "DeepSeek Harness 极简 PTC 预设插件：Python / TypeScript 工具编排、Windows Git Bash 适配与宿主约束保留。欢迎提交 issues 和 PR。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./gitbash-executor": "./presets/ptc-minimal/gitbash-executor.mjs",
    "./schedule-tools": "./presets/ptc-minimal/schedule-tools.mjs",
    "./ptc-persona": "./presets/ptc-minimal/ptc-persona.mjs",
    "./persistent-node.patch.yml": "./presets/ptc-minimal/persistent-node.patch.yml",
    "./client": "./lib/update-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/plugin-icon.webp",
    "./gitbash-executor/locale/*.json": "./locale/gitbash-executor/*.json",
    "./gitbash-executor/icon": "./assets/plugin-icon.webp",
    "./schedule-tools/locale/*.json": "./locale/schedule-tools/*.json",
    "./schedule-tools/icon": "./assets/plugin-icon.webp",
    "./ptc-persona/locale/*.json": "./locale/ptc-persona/*.json",
    "./ptc-persona/icon": "./assets/plugin-icon.webp"
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "ptc-minimal.patch.yml",
    "docs",
    "CHANGELOG.md",
    "assets/plugin-icon.webp",
    "locale"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./ptc-minimal.patch.yml"
      ]
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent-preset",
    "dsh-plugin",
    "deepseek",
    "llm-agent",
    "minimal",
    "ptc",
    "we-lets",
    "chain-of-thought",
    "ai-agent",
    "programmatic-tool-calling",
    "code-execution",
    "scheduling"
  ],
  "license": "MIT",
  "author": "stardustlc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-minimal-ptc.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-minimal-ptc/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-minimal-ptc#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "scripts": {
    "test": "npm run build && node --test",
    "build": "node scripts/build-updates.mjs"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "js-yaml": "4.1.1"
  },
  "dependencies": {
    "@stardustlc/dsh-updates": "0.2.3"
  },
  "icon": "./assets/plugin-icon.webp"
}
