{
  "name": "dsh-minimal-ptc",
  "version": "0.4.5",
  "description": "DeepSeek Harness 极简 PTC 预设：简洁提示词、run_code 工具编排、完整插件工具，以及 Windows Git Bash 和持久 PowerShell。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent-preset",
    "dsh-plugin",
    "deepseek",
    "llm-agent",
    "minimal",
    "ptc",
    "we-lets",
    "chain-of-thought"
  ],
  "license": "MIT",
  "author": "stardustlc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-minimal-ptc.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-minimal-ptc/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-minimal-ptc#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "packageManager": "pnpm@11.7.0"
}
