{
  "name": "dsh-minimal-ptc",
  "version": "0.6.1",
  "description": "把官方极简提示词与 PTC 编排组合起来，提供完整插件工具和 Windows 终端适配。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./gitbash-executor": "./presets/ptc-minimal/gitbash-executor.mjs",
    "./schedule-tools": "./presets/ptc-minimal/schedule-tools.mjs",
    "./ptc-persona": "./presets/ptc-minimal/ptc-persona.mjs",
    "./persistent-node.patch.yml": "./presets/ptc-minimal/persistent-node.patch.yml",
    "./client": "./lib/update-client.js"
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "ptc-minimal.patch.yml",
    "docs",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./ptc-minimal.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent-preset",
    "dsh-plugin",
    "deepseek",
    "llm-agent",
    "minimal",
    "ptc",
    "we-lets",
    "chain-of-thought"
  ],
  "license": "MIT",
  "author": "stardustlc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-minimal-ptc.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-minimal-ptc/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-minimal-ptc#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "test": "npm run build && node --test",
    "build": "node scripts/build-updates.mjs"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "js-yaml": "4.1.1"
  },
  "dependencies": {
    "@stardustlc/dsh-updates": "0.1.1"
  }
}
